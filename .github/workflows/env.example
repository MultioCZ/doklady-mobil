# zkopírujte jako .env a vyplňte
DATABASE_URL=postgresql+psycopg://doklady:HESLO@localhost:5432/doklady
STORAGE_DIR=/var/lib/doklady/files
SECRET_KEY=dlouhy-nahodny-retezec-alespon-32-znaku
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
# rules = jen bez AI, hybrid = AI jen když něco chybí (doporučeno), ai = vždy AI
EXTRACTION_MODE=hybrid
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=faktury@mojefirma.cz
SMTP_PASSWORD=...
SMTP_FROM=faktury@mojefirma.cz
PUBLIC_URL=https://doklady.multio.cz
APP_SCHEME=multiodoklady
INVITATION_DAYS=14
ADMIN_EMAIL=info@mojefirma.cz
ADMIN_PASSWORD=zmente-po-prvnim-prihlaseni
